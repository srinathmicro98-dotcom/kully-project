PORT=3000

GROQ_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
COHERE_API_KEY=
TAVILY_API_KEY=

# Auth/session verification only — login itself (username/password/JWT
# issuance) lives in the control-plane Lambda (see lambda/control-plane/),
# which must be configured with the SAME JWT_SECRET as this box.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Shared secret the Lambda's idle-checker sends to GET /internal/last-activity.
# Must match the Lambda's INTERNAL_API_SECRET.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
INTERNAL_API_SECRET=
