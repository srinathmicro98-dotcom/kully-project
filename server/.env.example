PORT=3000

GROQ_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
COHERE_API_KEY=
TAVILY_API_KEY=

# Auth/session verification only — login itself (username/password/JWT
# issuance) lives in the control-plane Lambda (see lambda/control-plane/),
# which must be configured with the SAME JWT_SECRET as this box.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Shared secret the Lambda's idle-checker sends to GET /internal/last-activity.
# Must match the Lambda's INTERNAL_API_SECRET.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
INTERNAL_API_SECRET=

# Shared secret + Function URLs for the two sandboxed code-runner Lambdas
# (lambda/code-runner-node, lambda/code-runner-python). Must match their
# CODE_RUNNER_SECRET env var.
CODE_RUNNER_SECRET=
CODE_RUNNER_NODE_URL=
CODE_RUNNER_PYTHON_URL=

# Optional: GitHub integration for the dev agent (github_read_file/write_file/
# list_files/create_pr tools). Leave both blank to disable the tools entirely
# — the dev agent just won't advertise them. Use a fine-grained PAT scoped to
# only the repos you want it touching, with Contents + Pull requests
# read/write permissions, nothing broader.
GITHUB_TOKEN=
GITHUB_ALLOWED_REPOS=
