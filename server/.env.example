# Single-user sign-in (no signup endpoint exists at all).
# Generate AUTH_PASSWORD_HASH with:
#   node -e "require('bcryptjs').hash(process.argv[1], 10).then(h => console.log(h))" 'your-password'
# Generate JWT_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
JWT_SECRET=
